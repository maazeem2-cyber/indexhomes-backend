# Server
PORT=4000
NODE_ENV=development
# Comma-separated. On Vercel include your frontend URL, e.g.
# https://indexhome-front.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Public frontend URL (email confirm / reset links). Production:
# FRONTEND_URL=https://indexhome-front.vercel.app
FRONTEND_URL=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# First admin (used by npm run seed:admin)
ADMIN_EMAIL=Maazeem2@icloud.com
ADMIN_PASSWORD=ChangeMe_IndexHomes_2026!
ADMIN_DISPLAY_NAME=IndexHomes Admin

# Plot images upload to Supabase Storage bucket: plot-images
# Run supabase/migrations/004_plot_images_storage.sql (or let the API create the bucket)

